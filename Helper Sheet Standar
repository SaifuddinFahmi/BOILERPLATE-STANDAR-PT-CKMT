/**
 * LIB_CKMT_SHEET v1.0.0
 * Helper CRUD Sheet yang aman & konsisten
 */
var CKMTSheet = (function() {
  'use strict';

  function _ss() { return SpreadsheetApp.getActiveSpreadsheet(); }

  function ensure(name, headers) {
    const ss = _ss();
    let sh = ss.getSheetByName(name);
    if (!sh) {
      sh = ss.insertSheet(name);
      if (headers && headers.length) {
        sh.appendRow(headers);
        sh.getRange(1,1,1,headers.length)
          .setFontWeight('bold').setBackground('#1E293B').setFontColor('#fff');
        sh.setFrozenRows(1);
      }
    } else if (headers && headers.length && sh.getLastRow() === 0) {
      sh.appendRow(headers);
      sh.getRange(1,1,1,headers.length)
        .setFontWeight('bold').setBackground('#1E293B').setFontColor('#fff');
      sh.setFrozenRows(1);
    }
    return sh;
  }

  function read(name, opts) {
    opts = opts || {};
    const sh = _ss().getSheetByName(name);
    if (!sh || sh.getLastRow() <= 1) return [];
    const nCols = opts.cols || sh.getLastColumn();
    const rows = sh.getRange(2, 1, sh.getLastRow()-1, nCols).getValues();
    if (!opts.headers) return rows;
    return rows.map(function(r){
      const obj = {};
      opts.headers.forEach(function(h, i){ obj[h] = r[i]; });
      return obj;
    });
  }

  function append(name, row) {
    const sh = _ss().getSheetByName(name);
    if (!sh) throw new Error('Sheet tidak ditemukan: ' + name);
    sh.appendRow(row);
    return true;
  }

  function appendMany(name, rows) {
    if (!rows || !rows.length) return false;
    const sh = _ss().getSheetByName(name);
    if (!sh) throw new Error('Sheet tidak ditemukan: ' + name);
    const startRow = sh.getLastRow() + 1;
    sh.getRange(startRow, 1, rows.length, rows[0].length).setValues(rows);
    return true;
  }

  function findIndex(name, colIndex, value) {
    const sh = _ss().getSheetByName(name);
    if (!sh || sh.getLastRow() <= 1) return -1;
    const data = sh.getRange(2, 1, sh.getLastRow()-1, 1).getValues();
    const v = String(value);
    for (let i = 0; i < data.length; i++) {
      if (String(data[i][0]) === v) return i + 2; // row number
    }
    return -1;
  }

  function update(name, rowNum, row) {
    const sh = _ss().getSheetByName(name);
    if (!sh) throw new Error('Sheet tidak ditemukan: ' + name);
    sh.getRange(rowNum, 1, 1, row.length).setValues([row]);
    return true;
  }

  function remove(name, rowNum) {
    const sh = _ss().getSheetByName(name);
    if (!sh) throw new Error('Sheet tidak ditemukan: ' + name);
    sh.deleteRow(rowNum);
    return true;
  }

  function withLock(fn, timeoutMs) {
    const lock = LockService.getDocumentLock();
    lock.waitLock(timeoutMs || 20000);
    try { return fn(); }
    finally { try { lock.releaseLock(); } catch(e){} }
  }

  return { ensure, read, append, appendMany, findIndex, update, remove, withLock };
})();
