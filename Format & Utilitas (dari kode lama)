/**
 * LIB_CKMT_FORMAT v1.0.0
 * Fungsi utilitas format (dari sistem lama, TIDAK DIUBAH)
 */
var CKMTFormat = (function() {
  'use strict';

  function num(value, fallback) {
    if (fallback === undefined) fallback = 0;
    if (value === null || value === undefined || value === '') return fallback;
    if (typeof value === 'number') return isFinite(value) ? value : fallback;
    const n = parseFloat(String(value).replace(/\s/g,'').replace(/,/g,''));
    return isFinite(n) ? n : fallback;
  }

  function date(value) {
    if (!value) return null;
    if (Object.prototype.toString.call(value) === '[object Date]') {
      return isNaN(value.getTime()) ? null : value;
    }
    const m = String(value).match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (m) return new Date(+m[1], +m[2]-1, +m[3]);
    const d = new Date(value);
    return isNaN(d.getTime()) ? null : d;
  }

  function dateStr(value, fallback) {
    fallback = fallback || '';
    try {
      const d = date(value);
      if (!d) return fallback;
      return Utilities.formatDate(d,
        Session.getScriptTimeZone() || 'Asia/Jakarta', 'yyyy-MM-dd');
    } catch(e) { return fallback; }
  }

  function rp(v) {
    const n = Number(v) || 0;
    return 'Rp ' + n.toLocaleString('id-ID',
      { minimumFractionDigits:2, maximumFractionDigits:2 });
  }

  function rp0(v) {
    const n = Number(v) || 0;
    return 'Rp ' + n.toLocaleString('id-ID');
  }

  function terbilang(angka) {
    // [fungsi dari kode lama — TIDAK DIUBAH]
    let n = parseFloat(angka) || 0;
    const isNeg = n < 0;
    n = Math.abs(Math.floor(n));
    if (n === 0) return 'nol';
    const bil = ['','satu','dua','tiga','empat','lima','enam','tujuh','delapan',
                 'sembilan','sepuluh','sebelas'];
    function c(x) {
      if (x < 12) return ' ' + bil[x];
      if (x < 20) return c(x-10) + ' belas';
      if (x < 100) return c(Math.floor(x/10)) + ' puluh' + c(x%10);
      if (x < 200) return ' seratus' + c(x-100);
      if (x < 1000) return c(Math.floor(x/100)) + ' ratus' + c(x%100);
      if (x < 2000) return ' seribu' + c(x-1000);
      if (x < 1e6) return c(Math.floor(x/1000)) + ' ribu' + c(x%1000);
      if (x < 1e9) return c(Math.floor(x/1e6)) + ' juta' + c(x%1e6);
      if (x < 1e12) return c(Math.floor(x/1e9)) + ' milyar' + c(x%1e9);
      return '';
    }
    const t = c(n).trim();
    return isNeg ? 'minus ' + t : t;
  }

  function escapeHtml(str) {
    if (str == null) return '';
    return String(str)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  return { num, date, dateStr, rp, rp0, terbilang, escapeHtml };
})();
